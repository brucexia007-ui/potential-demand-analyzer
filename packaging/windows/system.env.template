# Kanyikan Windows x64 离线安装模板。
# 发布流水线必须用签名 manifest 中的真实镜像引用替换下列占位摘要；
# 安装器必须生成全部空白秘密。禁止直接使用本文件启动服务。

ENV=production
DEPLOYMENT_PROFILE=local_appliance

# 六个 linux/amd64 镜像；源文件使用确定性占位摘要，打包时必须替换。
BACKEND_IMAGE=kanyikan/backend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
FRONTEND_IMAGE=kanyikan/frontend@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
POSTGRES_IMAGE=pgvector/pgvector@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
REDIS_IMAGE=redis@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
NGINX_IMAGE=kanyikan/nginx@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
BROWSERLESS_IMAGE=browserless/chrome@sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

# 安装器生成；不得通过命令行传入或写入日志。
SECRET_KEY=
CONFIG_ENCRYPTION_KEY=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BROWSERLESS_TOKEN=

# 安装器在生成并 URL 编码密码后写入。
POSTGRES_DB=demand_analyzer
POSTGRES_USER=demand_user
DATABASE_URL=
REDIS_URL=

# 唯一本地 HTTPS 入口。
APP_BIND_HOST=127.0.0.1
APP_HTTPS_PORT=10443
CORS_ALLOW_ORIGINS=https://127.0.0.1:10443
AUTH_COOKIE_SECURE=true
TLS_ENABLED=true
TLS_CERT_PATH=/etc/nginx/certs/localhost.crt
TLS_KEY_PATH=/etc/nginx/certs/localhost.key

# 内部服务与安全门禁。
BROWSERLESS_URL=http://browserless:3000
SECURITY_OUTBOUND_CHECK_ENABLED=true

# 可观测性与保留策略；Sentry 留空即禁用。
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
SNAPSHOT_RETENTION_DAYS=90

# LLM、搜索、模型路由、抓取和预算只允许由首次配置向导写入数据库。
