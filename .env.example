# ======================================
# 潜在需求分析系统 - 环境变量配置
# ======================================
# 复制此文件为 .env 并根据实际环境修改配置
# ======================================

# --------------------------------------
# Core
# --------------------------------------
ENV=development

# --------------------------------------
# 安全配置（生产环境务必修改）
# --------------------------------------
# JWT 签名密钥，生产环境必须设置强随机字符串
# 未设置时系统自动生成随机 Key（每次重启 Key 会变，所有已签发 Token 失效）
# SECRET_KEY=your-random-secret-key-at-least-32-chars

# HttpOnly 认证 Cookie 是否仅允许 HTTPS 传输。
# 本地 development 使用 false；正式环境必须设置为 true，否则后端拒绝启动认证流程。
AUTH_COOKIE_SECURE=false

# 配置中心加密密钥（v3 WBS-1 新增，用于加密保存 API Key 等敏感配置）
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生产环境必须设置，否则配置中心无法保存 API Key
# CONFIG_ENCRYPTION_KEY=your-fernet-key-here

# Admin 初始密码（仅首次初始化时使用，生产环境修改）
# ADMIN_PASSWORD=your-secure-admin-password

# CORS 允许的前端域名（逗号分隔），默认仅允许本地开发端口
# CORS_ALLOW_ORIGINS=https://127.0.0.1:10443

# --------------------------------------
# Backend 配置
# --------------------------------------
# Docker 内部网络配置，请保持 :6379 和 :5432 不变
# 注意：如果要在宿主机本地直接运行 backend (不使用 Docker)
#       请将 REDIS_URL 改为 redis://localhost:6380/0
#       请将 DATABASE_URL 改为 postgresql+psycopg2://demand_user:demand_pass@localhost:5436/demand_analyzer
API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg2://demand_user:demand_pass@postgres:5432/demand_analyzer

# --------------------------------------
# LLM 配置（OpenAI 兼容格式）
# --------------------------------------
# 支持的服务商：
# - OpenAI: https://api.openai.com/v1
# - 阿里云 DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# - 其他兼容 OpenAI 接口的服务（如 Ollama, vLLM 等）
#
# 支持一个或多个 LLM Provider，主 Provider 不可用时可按模型路由降级。
# 命名规则：LLM_PROVIDER_<NAME>_BASE_URL / _API_KEY / _MODELS
# 降级顺序由 model_settings.json 的 fallback_models 控制。
# 至少配置一个完整的命名 Provider；也可在首次设置向导中写入数据库配置。
LLM_PROVIDER_PRIMARY_BASE_URL=http://litellm:4000
LLM_PROVIDER_PRIMARY_API_KEY=sk-no-key-required
LLM_PROVIDER_PRIMARY_MODELS=gpt-3.5-turbo
DEFAULT_MODEL=gpt-3.5-turbo
# 能力知识库 embedding 使用独立模型能力；所选 Provider 的 models 必须声明该模型。
EMBEDDING_MODEL=text-embedding-3-small
# 多个 Provider 声明同一 embedding 模型时，用名称显式选定；只有一个时可留空。
EMBEDDING_PROVIDER_NAME=

# 示例：主 Provider (DeepSeek) + 备选 (Qwen via DashScope)
# LLM_PROVIDER_PRIMARY_BASE_URL=https://api.deepseek.com
# LLM_PROVIDER_PRIMARY_API_KEY=sk-your-deepseek-key
# LLM_PROVIDER_PRIMARY_MODELS=deepseek-v4-pro,deepseek-v3
# LLM_PROVIDER_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_PROVIDER_QWEN_API_KEY=sk-your-dashscope-key
# LLM_PROVIDER_QWEN_MODELS=qwen3.5-plus,qwen-max,qwen-turbo
#
# 示例：KIMI K3（中国站；API Key 需来自 platform.kimi.com）
# LLM_PROVIDER_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# LLM_PROVIDER_MOONSHOT_API_KEY=sk-your-kimi-api-key
# LLM_PROVIDER_MOONSHOT_MODELS=kimi-k3
# DEFAULT_MODEL=kimi-k3

# --------------------------------------
# 搜索服务配置
# --------------------------------------
# 可选：bocha, duckduckgo, bing
SEARCH_PROVIDER=bocha

# 博查 AI 搜索 API（推荐国内使用）
# 两种鉴权方式（APPCODE 优先）：
#   1. 阿里云 API 网关 APPCODE —— 阿里云市场购买时使用 (https://market.aliyun.com)
#      需要设置 BOCHA_APPCODE，可选 BOCHA_API_URL（阿里云网关地址）
#   2. Bearer Token —— 博查官方直营时使用 (https://open.bochaai.com)
#      需要设置 BOCHA_API_KEY
BOCHA_API_URL=https://api.bocha.cn/v1/web-search
BOCHA_API_KEY=sk-your-bocha-api-key
# BOCHA_APPCODE=你的阿里云APPCODE（与 BOCHA_API_KEY 二选一，APPCODE 优先）

# DuckDuckGo（免费，但国内易被限流，无需 API Key）
# 无需配置

# Bing Search API（国内稳定，备选）
# API Key 获取：https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_API_KEY=

# Tavily Search API（备选）
TAVILY_API_KEY=

# --------------------------------------
# Frontend 配置
# --------------------------------------
# 前端 API 代理地址，浏览器端会直接访问此地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --------------------------------------
# 外部通知配置（Phase 6 新增）
# --------------------------------------
# 飞书/Lark 机器人 Webhook
# 获取方式：飞书群 → 设置 → 群机器人 → 添加机器人 → 复制 Webhook 地址
# NOTIFY_WEBHOOK_FEISHU=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# 企业微信机器人 Webhook
# 获取方式：群聊 → 群机器人 → 添加 → 复制 Webhook 地址
# NOTIFY_WEBHOOK_WECHAT=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 钉钉机器人 Webhook
# 获取方式：群设置 → 智能群助手 → 添加机器人 → 复制 Webhook 地址
# NOTIFY_WEBHOOK_DINGTALK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 通用 JSON Webhook（可与上述平台同时配置）
# NOTIFY_WEBHOOK_GENERIC=https://example.com/webhook

# SMTP 邮件通知（可选）
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=notify@example.com
# EMAIL_PASSWORD=your-password
# EMAIL_FROM=no-reply@example.com

# --------------------------------------
# 日志配置（Phase 8 新增）
# --------------------------------------
# 日志级别: DEBUG, INFO, WARNING, ERROR（默认 INFO）
# LOG_LEVEL=INFO

# 日志格式: text（开发，彩色可读）或 json（生产，结构化采集）
# LOG_FORMAT=text

# --------------------------------------
# Sentry 错误追踪（Phase 9 新增）
# --------------------------------------
# Sentry DSN（留空禁用 Sentry，不影响启动）
# SENTRY_DSN=https://<key>@sentry.io/<project>

# 性能追踪采样率（0.0 ~ 1.0，默认 0.1）
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --------------------------------------
# Prometheus 指标（Phase 9 新增）
# --------------------------------------
# 启用 /metrics 端点（生产中通过 Docker 内网采集，不对外暴露）
# METRICS_ENABLED=true

# --------------------------------------
# URL 安全配置（Phase 6 新增）
# --------------------------------------
# 域名白名单（glob 通配符，逗号分隔），空 = 全部允许
# FETCH_ALLOWED_DOMAINS=*.example.com,trusted.org

# 域名黑名单（优先级高于白名单）
# FETCH_BLOCKED_DOMAINS=evil.com,*.blocked.net

# browserless/chrome 地址（Playwright 动态抓取）
# BROWSERLESS_URL=http://browserless:3000

# 外网安全校验总开关（SSRF/DNS rebinding 防护），默认 true
# ⚠️ 设为 false 将关闭全部外网安全校验，仅限受控开发环境
# SECURITY_OUTBOUND_CHECK_ENABLED=true

# 非公网地址放行白名单（逗号分隔 CIDR）
# 仅用于代理/DNS 劫持类开发环境——例如 Clash fake-ip 模式会把所有域名
# 解析到 198.18.0.0/15 假地址段，导致 DNS rebinding 防护全量误杀；
# 此时可放行该段。生产环境不应配置，配置后段内地址不再做公网校验。
# SECURITY_OUTBOUND_ALLOW_CIDRS=198.18.0.0/15

# --------------------------------------
# LLM Token 单价（预算审计金额计算，USD / 百万 Token）
# --------------------------------------
# 不配置时回退到内置厂商价目（gateway_client._BUILTIN_PRICES）；
# 价格以厂商最新公告为准，建议显式配置覆盖。
# LLM_PROVIDER_DEEPSEEK_INPUT_USD_PER_MILLION=0.27
# LLM_PROVIDER_DEEPSEEK_OUTPUT_USD_PER_MILLION=1.10

# --------------------------------------
# 数据库备份配置（Phase 9 新增）
# --------------------------------------
# 备份文件存储目录（容器内路径，worker 服务挂载 ./deploy/backups → /backups）
# BACKUP_DIR=/backups

# 备份保留天数（默认 7 天，超过后自动删除）
# BACKUP_RETENTION_DAYS=7

# --------------------------------------
# TLS / HTTPS 配置（Phase 8 新增）
# --------------------------------------
# 启用 HTTPS（生产环境建议启用）
# TLS_ENABLED=true

# SSL 证书路径（容器内路径）
# 自签名证书: 运行 bash deploy/generate-self-signed-cert.sh 生成
# Let's Encrypt: certbot 自动管理到 ./deploy/certs/live/<domain>/
# TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
# TLS_KEY_PATH=/etc/nginx/certs/privkey.pem
