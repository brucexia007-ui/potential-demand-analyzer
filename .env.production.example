# 复制为 .env.production 后再填写。禁止提交 .env.production 或任何真实密钥。
ENV=production
DEPLOYMENT_PROFILE=server_tls

# 只部署发布流水线输出的不可变镜像摘要（禁止使用 latest）
BACKEND_IMAGE=ghcr.io/your-org/your-repo/backend@sha256:replace-with-release-digest
FRONTEND_IMAGE=ghcr.io/your-org/your-repo/frontend@sha256:replace-with-release-digest
NGINX_IMAGE=nginx@sha256:replace-with-verified-digest
REDIS_IMAGE=redis@sha256:replace-with-verified-digest
CERTBOT_IMAGE=certbot/certbot@sha256:replace-with-verified-digest

# 生产安全门禁（均为必填）
SECRET_KEY=replace-with-at-least-48-random-characters
CONFIG_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
DATABASE_URL=postgresql+psycopg2://demand_user:replace-with-url-encoded-database-password@postgres:5432/demand_analyzer
REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379/0
AUTH_COOKIE_SECURE=true
SECURITY_OUTBOUND_CHECK_ENABLED=true

# 站点与 TLS
APP_HTTPS_PORT=10443
CORS_ALLOW_ORIGINS=https://research.example.com
NEXT_PUBLIC_API_BASE_URL=
TLS_ENABLED=true
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# Browserless；生产部署必须使用独立强随机 Token
BROWSERLESS_URL=http://browserless:3000
BROWSERLESS_TOKEN=replace-with-a-strong-browserless-token

# LLM、搜索、模型路由、抓取和预算由首次配置向导写入数据库，禁止在此处配置。

# 可观测性与审计；Sentry 可选，留空即禁用。
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# 数据留存与备份
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
SNAPSHOT_RETENTION_DAYS=90
